{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pies Pear Music",
  "version": "0.1.0",
  "identifier": "com.pies.pear-music",
  "build": {
    "beforeDevCommand": "npm run prepare-sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Pies Pear Music",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "A local music library sync companion",
    "longDescription": "Pies Pear Music is a Linux desktop application for managing a local music library with user-installed download and media tools.",
    "externalBin": [
      "binaries/pies-backend"
    ],
    "icon": [
      "icons/pear.svg",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
