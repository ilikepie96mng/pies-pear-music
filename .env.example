# ==============================================================================
# Pies Pear Music - Environment Configuration
# ==============================================================================

# Web Port (default 10025)
PORT=10025

# Storage Mounts
CONFIG_PATH=./config
MUSIC_PATH=./music
STAGING_PATH=/tmp/pies-staging

# Optional: Password protect the web interface
# PIES_AUTH_PASSWORD=change_this_to_a_secure_password

# Optional: Google Gemini API key for AI playlists & taste profiling
# GEMINI_API_KEY=AIzaSy...
